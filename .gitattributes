# Palette/license checksums describe exact source bytes; never normalize line endings.
/resources/colormaps/** -text
# Upstream source bytes intentionally retain their original whitespace.
/resources/colormaps/source/** -whitespace
/resources/colormaps.qrc -text
/licenses/colormaps/** -text
# Decode dependency provenance hashes cover exact upstream bytes.
/third_party/hdf_filters/bitshuffle/** -text -whitespace
/third_party/hdf_filters/lz4/** -text -whitespace
/third_party/hdf_filters/zstd/** -text -whitespace
# Preserve pinned ecCodes notices verbatim, including upstream whitespace.
/licenses/eccodes/*.txt -text -whitespace
/testdata/grib/** -text -whitespace
# Preserve original coastline data and license bytes for provenance verification.
/resources/coastlines/low/*.dat -text -whitespace
/resources/coastlines/low/*.json -text -whitespace
/resources/coastlines/low/UPSTREAM_README.md -text -whitespace
/licenses/coastlines/COPYING* -text -whitespace
/licenses/coastlines/LICENSE.mit -text -whitespace
/licenses/proj/* -text -whitespace
# The vendored 06 kernels and SCRIP notice have byte-level provenance hashes.
/third_party/icosahedral/*.c -text -whitespace
/third_party/icosahedral/*.h -text -whitespace
/licenses/icosahedral/LICENSE_SCRIP -text -whitespace
/third_party/icosahedral/qt-reference/*.cpp -text -whitespace
/third_party/icosahedral/qt-reference/*.hpp -text -whitespace
