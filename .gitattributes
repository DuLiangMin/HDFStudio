# Palette/license checksums describe exact source bytes; never normalize line endings.
/resources/colormaps/** -text
# Upstream source bytes intentionally retain their original whitespace.
/resources/colormaps/source/** -whitespace
/resources/colormaps.qrc -text
/licenses/colormaps/** -text
# Decode dependency provenance hashes cover exact upstream bytes.
/third_party/hdf_filters/bitshuffle/** -text -whitespace
/third_party/hdf_filters/lz4/** -text -whitespace
/third_party/hdf_filters/zstd/** -text -whitespace
# Preserve pinned ecCodes notices verbatim, including upstream whitespace.
/licenses/eccodes/*.txt -text -whitespace
/testdata/grib/** -text -whitespace
