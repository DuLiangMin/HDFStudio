# Pinned native GRIB backend; development dependencies remain outside the source snapshot.
set(HDFSTUDIO_ECCODES_ROOT "${CMAKE_SOURCE_DIR}/ext/eccodes" CACHE PATH "Native ecCodes development files")
if(NOT EXISTS "${HDFSTUDIO_ECCODES_ROOT}/include/eccodes.h")
  message(FATAL_ERROR "ecCodes missing: configure HDFSTUDIO_ECCODES_ROOT (see docs/GRIB.md)")
endif()
add_library(hdf_eccodes SHARED IMPORTED)
set_target_properties(hdf_eccodes PROPERTIES IMPORTED_IMPLIB "${HDFSTUDIO_ECCODES_ROOT}/lib/eccodes.lib" IMPORTED_LOCATION "${HDFSTUDIO_ECCODES_ROOT}/bin/eccodes.dll" INTERFACE_INCLUDE_DIRECTORIES "${HDFSTUDIO_ECCODES_ROOT}/include")
add_library(grib_backend STATIC src/core/grib/grib_core.cpp src/core/grib/grib_data.cpp)
target_include_directories(grib_backend PUBLIC "${CMAKE_SOURCE_DIR}/src/core" "${CMAKE_SOURCE_DIR}/src/core/grib")
target_link_libraries(grib_backend PUBLIC Qt6::Core hdf_eccodes)
target_compile_definitions(grib_backend PRIVATE NOMINMAX WIN32_LEAN_AND_MEAN)
if(MSVC)
  target_compile_options(grib_backend PRIVATE /utf-8)
endif()
function(hdf_deploy_grib target)
  add_custom_command(TARGET ${target} POST_BUILD COMMAND ${CMAKE_COMMAND} -E copy_directory "${HDFSTUDIO_ECCODES_ROOT}/bin" "$<TARGET_FILE_DIR:${target}>")
endfunction()
