# Imported static HDF5/HL and zlib used by the local netCDF-C DLL build.
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(h5 "${root}/build/hdf5-1.8.20")
set(HDF5_INCLUDE_DIRS "${h5};${root}/ext/hdf5-1.8.20/src;${root}/ext/hdf5-1.8.20/hl/src;${h5}/hl/src")
set(HDF5_VERSION 1.8.20)
set(HDF5_INCLUDE_DIR "${HDF5_INCLUDE_DIRS}")
set(HDF5_LIBRARIES "${h5}/bin/Release/libhdf5_hl.lib;${h5}/bin/Release/libhdf5.lib;${root}/build/zlib/Release/zlibstatic.lib;shlwapi;ws2_32")
if(NOT TARGET HDF5::HDF5)
  add_library(HDF5::HDF5 INTERFACE IMPORTED)
  add_library(hdf5::hdf5_hl ALIAS HDF5::HDF5)
  add_library(hdf5::hdf5 ALIAS HDF5::HDF5)
  set_target_properties(HDF5::HDF5 PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${HDF5_INCLUDE_DIRS}" INTERFACE_LINK_LIBRARIES "${HDF5_LIBRARIES}")
endif()
set(HDF5_FOUND TRUE)
set(HDF5_C_FOUND TRUE)
set(HDF5_HL_FOUND TRUE)
